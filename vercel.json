{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/pramaanx run build",
  "outputDirectory": "artifacts/pramaanx/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://pramaanx-api.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
